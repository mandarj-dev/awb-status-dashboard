# =====================================================================
#  AWB Status Dashboard settings.
#  Local: use the Setup page in the browser - it fills this file for you.
#  Vercel: set the same keys in Project → Settings → Environment Variables
#  (the Setup page cannot write files on Vercel). Minimum for a working
#  deploy: ST_MONGO_URI, ST_DB_NAME, ST_COLLECTION, PF_DB_NAME, PF_COLLECTION.
# =====================================================================
APP_TITLE=AWB Status Dashboard
CORS_ORIGINS=*
MAX_AWBS_PER_REQUEST=1000
QUERY_BATCH_SIZE=200
MONGO_TIMEOUT_MS=15000
MONGO_MAX_TIME_MS=60000
# secondaryPreferred keeps dashboard reads off the primary when a replica set exists
MONGO_READ_PREFERENCE=secondaryPreferred
DISPLAY_TZ=Asia/Kolkata
# Timezone assumed for dates stored as strings without an offset
DATE_STRINGS_TZ=Asia/Kolkata

# ---------------------------------------------------------------------
#  Open cases
# ---------------------------------------------------------------------
# Closed dispatch status codes - these AWBs are skipped (names come from Dispatch-status-Mapping.xlsx)
CLOSED_STATUS_CODES=5,13,14,15,16
# Optional extra status NAMES to treat as closed
OPEN_EXCLUDE_STATUSES=
# Only shipments created in the last N days (0 = no limit). Keeps prod queries light.
OPEN_LOOKBACK_DAYS=60
EXPORT_MAX_ROWS=50000
FILTER_CACHE_SECONDS=300

# ---------------------------------------------------------------------
#  SMART TRACKING  (header: "Smart Tracking")
#  *_FIELDS / *_KEYS = comma-separated candidate paths, first non-empty wins.
#  For open-case filters/grouping the FIRST path of STATUS / COURIER / CREATED is used.
# ---------------------------------------------------------------------
ST_LABEL=Smart Tracking
ST_MONGO_URI=
ST_DB_NAME=
ST_COLLECTION=
# Single field, should be indexed
ST_AWB_FIELD=airwaybilno
ST_COURIER_FIELDS=courier_name,courier,courier_code
ST_STATUS_FIELDS=status.dispatch_status,dispatch_status,current_status
ST_STATUS_CODE_FIELDS=status.dispatch_status_code,dispatch_status_code
ST_STATUS_DATE_FIELDS=status.status_date,status_date,status.dispatch_status_date
ST_PICKUP_DATE_FIELDS=status.pickup_date,pickup_date
# When tracking was last fetched. If none exist, falls back to latest tracking event sync time.
ST_LAST_TRACK_FIELDS=last_tracked_at,last_track_date,updated_at
ST_CREATED_FIELDS=created_at,created_date,booking_date
# Open Cases date range uses the order date
ST_ORDER_DATE_FIELD=status.order_date
# Tracking history array and the keys inside each event
ST_TRACKING_FIELD=tracking
ST_TRACK_STATUS_KEYS=courier_status,status,status_description
ST_TRACK_CODE_KEYS=parent_status_code,status_code
ST_TRACK_DATE_KEYS=status_date,date,event_date,status_created_date
ST_TRACK_SYNC_KEYS=status_created_date,created_at
ST_TRACK_LOCATION_KEYS=location,city,current_location
ST_TRACK_REMARK_KEYS=remark,remarks,status_description

# ---------------------------------------------------------------------
#  PLATFORM / INSTALOGIX  (header: "Platform")
#  Leave PF_MONGO_URI blank to reuse ST_MONGO_URI.
# ---------------------------------------------------------------------
PF_LABEL=Platform
PF_MONGO_URI=
PF_DB_NAME=
PF_COLLECTION=
PF_AWB_FIELD=airwaybilno
PF_COURIER_FIELDS=courier_name,courier,courier_code
PF_STATUS_FIELDS=status.dispatch_status,dispatch_status,current_status
PF_STATUS_CODE_FIELDS=status.dispatch_status_code,dispatch_status_code
PF_STATUS_DATE_FIELDS=status.status_date,status_date
PF_PICKUP_DATE_FIELDS=status.pickup_date,pickup_date
PF_LAST_TRACK_FIELDS=last_tracked_at,last_track_date,updated_at
PF_CREATED_FIELDS=created_at,created_date,booking_date
PF_ORDER_DATE_FIELD=status.order_date
PF_TRACKING_FIELD=tracking
PF_TRACK_STATUS_KEYS=courier_status,status,status_description
PF_TRACK_CODE_KEYS=parent_status_code,status_code
PF_TRACK_DATE_KEYS=status_date,date,event_date,status_created_date
PF_TRACK_SYNC_KEYS=status_created_date,created_at
PF_TRACK_LOCATION_KEYS=location,city,current_location
PF_TRACK_REMARK_KEYS=remark,remarks,status_description

# AWB shown as the sample shipment on the Setup page
SETUP_SAMPLE_AWB=1095160

# Settings PIN (set from the Setup page; stored as a hash)
SETUP_PIN_HASH=
